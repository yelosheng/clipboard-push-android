<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 保持唤醒（后台保活） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ClipboardService 用 connectedDevice：它维持的是与一台配对 PC 的长连接。
         **不能用 dataSync**——从 targetSdk 35 起，dataSync 前台服务每 24 小时累计
         只能跑 6 小时，超额后 startForeground() 直接抛
         ForegroundServiceStartNotAllowedException，而且只有用户手动把 app 切到
         前台才会重置配额。看门狗和 FCM 唤醒在那种状态下全部失效。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- connectedDevice 的前置条件：必须声明 CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE /
         CHANGE_WIFI_MULTICAST_STATE / NFC / TRANSMIT_IR 之一，否则 startForeground()
         会抛 SecurityException。这里取 CHANGE_NETWORK_STATE（普通权限，无需运行时授权）。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 仍然需要：UploadWorker / DownloadWorker 走 WorkManager 的前台任务，
         它们是真正的短时数据传输，dataSync 才是正确类型，也跑不满 6 小时配额。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 通知权限 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".ClipboardManApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipboardMan"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipboardMan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 强制覆盖 ZXing 扫描界面的方向 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- 快速推送 Activity (从通知栏启动，透明) -->
        <activity
            android:name=".QuickPushActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipboardMan.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="" />

        <!-- 分享接收 Activity -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipboardMan.Transparent">
            <!-- 接收文本 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 接收图片 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- 接收任意文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 前台服务：维持与配对 PC 的长连接，故为 connectedDevice 而非 dataSync。
             官方定义："与需要蓝牙、NFC、IR、USB 或网络连接的外部设备交互"。
             关键差别是 connectedDevice 没有运行时长上限，dataSync 有 6 小时/24 小时。 -->
        <service
            android:name=".service.ClipboardService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- FCM 推送服务（后台保活双通道：app 被冻结/杀死时仍可收文本/被唤醒） -->
        <service
            android:name=".service.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 连接看门狗接收器：AlarmManager 定时唤醒，检查连接是否已成僵尸并强制重连。
             这是唯一不依赖本进程线程的自检途径（进程被厂商 ROM 冻结时线程全停）。 -->
        <receiver
            android:name=".service.ConnectionWatchdogReceiver"
            android:exported="false" />

        <!-- WorkManager 前台服务 (Android 14+ 需要声明 foregroundServiceType) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- FileProvider (用于文件分享) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
